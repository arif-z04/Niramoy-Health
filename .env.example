# ==============================================================================
# NIRAMOY HEALTH - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development. Never commit .env or secrets to Git.

# Database Configuration (Development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=niramoy_health_dev
DB_USER=niramoy_user
DB_PASSWORD=your_secure_dev_password_here
DB_SSLMODE=prefer

# Database Configuration (Testing)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=niramoy_health_test
TEST_DB_USER=niramoy_user
TEST_DB_PASSWORD=your_secure_test_password_here
TEST_DB_SSLMODE=prefer

# Standard .NET / Npgsql Connection Strings
# For EF Core and ASP.NET Core (Phase 2)
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=niramoy_health_dev;Username=niramoy_user;Password=your_secure_dev_password_here;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;Include Error Detail=true;"
ConnectionStrings__TestConnection="Host=127.0.0.1;Port=5432;Database=niramoy_health_test;Username=niramoy_user;Password=your_secure_test_password_here;Pooling=true;"

# Bangladesh Payment Gateways (Sandbox / Mock Credentials for Phase 2)
# Real credentials must never be committed; sandbox URLs used for development.
BKASH_APP_KEY=your_bkash_sandbox_app_key
BKASH_APP_SECRET=your_bkash_sandbox_app_secret
BKASH_USERNAME=your_bkash_sandbox_username
BKASH_PASSWORD=your_bkash_sandbox_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=your_nagad_sandbox_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_sandbox_public_key
NAGAD_PRIVATE_KEY=your_nagad_sandbox_private_key
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs

# Application Settings
APP_ENV=Development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_very_long_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
